# Скопируйте в .env и заполните.

# Порт на хосте, на котором будет доступен сервер (ESP32 шлёт на http://<IP_ПК>:HOST_PORT/webhook/nfc)
HOST_PORT=8090

# Общий секрет с прошивкой (WEBHOOK_API_KEY в firmware/nfc_reader/config.h).
# Пусто — аутентификация отключена (только для отладки!).
API_KEY=change-me

# Необязательно: куда пересылать каждый скан (n8n webhook, Laravel API и т.п.)
FORWARD_URL=
FORWARD_TIMEOUT=5

LOG_LEVEL=INFO
